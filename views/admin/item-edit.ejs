<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Report - Campus Lost &amp; Found</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        .report-form {
            max-width: 650px;
            margin: 30px auto;
            padding: 25px;
            background: white;
            border-radius: 10px;
        }

        .report-form label {
            display: block;
            margin-top: 15px;
            font-weight: bold;
        }

        .report-form input,
        .report-form textarea,
        .report-form select {
            width: 100%;
            padding: 10px;
            margin-top: 6px;
            box-sizing: border-box;
        }

        .report-form textarea {
            min-height: 100px;
        }
    </style>
</head>

<body class="dashboard-bg">

<main class="dashboard-container">

    <form
        action="/admin/items/<%= item.id %>/edit"
        method="POST"
        class="report-form">

        <h1>Edit Report #<%= item.id %></h1>

        <label for="type">Report Type</label>
        <select name="type" id="type" required>
            <option value="lost" <%= item.type === 'lost' ? 'selected' : '' %>>
                Lost
            </option>
            <option value="found" <%= item.type === 'found' ? 'selected' : '' %>>
                Found
            </option>
        </select>

        <label for="title">Title</label>
        <input
            type="text"
            name="title"
            id="title"
            value="<%= item.title %>"
            required>

        <label for="description">Description</label>
        <textarea name="description" id="description"><%= item.description || '' %></textarea>

        <label for="category">Category</label>
        <select name="category" id="category" required>
            <% const categories = [
                'Wallet',
                'ID / Cards',
                'Phone / Charger',
                'Keys',
                'Bag',
                'Clothing',
                'Umbrella',
                'Books / Notes',
                'Other'
            ]; %>

            <% categories.forEach(category => { %>
                <option
                    value="<%= category %>"
                    <%= item.category === category ? 'selected' : '' %>>
                    <%= category %>
                </option>
            <% }); %>
        </select>

        <label for="location">Location</label>
        <input
            type="text"
            name="location"
            id="location"
            value="<%= item.location %>"
            required>

        <label for="date_lost_found">Date Lost or Found</label>
        <input
            type="date"
            name="date_lost_found"
            id="date_lost_found"
            value="<%= item.date_lost_found ? new Date(item.date_lost_found).toISOString().slice(0, 10) : '' %>"
            required>

        <label for="status">Status</label>
        <select name="status" id="status" required>
            <% ['open', 'claimed', 'resolved'].forEach(status => { %>
                <option
                    value="<%= status %>"
                    <%= item.status === status ? 'selected' : '' %>>
                    <%= status %>
                </option>
            <% }); %>
        </select>

        <br><br>

        <button type="submit" class="btn">Update Report</button>
        <a href="/admin/items" class="btn secondary">Cancel</a>

    </form>

</main>

</body>
</html>