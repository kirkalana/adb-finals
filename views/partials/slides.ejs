<% if (typeof slides !== 'undefined' && slides.length) { %>
<section class="cf" aria-label="Campus Guide">
  <h2>Campus Guide</h2>

  <div class="cf-stage" id="cfStage" tabindex="0">
    <button class="cf-arrow prev" type="button" aria-label="Previous">&#10094;</button>

    <% slides.forEach(s => { %>
      <a class="cf-card" href="<%= s.link || '#' %>" draggable="false">
        <img class="cf-img" src="/img/slides/<%= s.image %>" alt="<%= s.title %>" draggable="false">
        <div class="cf-body">
          <% if (s.tag) { %><span class="cf-tag"><%= s.tag %></span><% } %>
          <h3><%= s.title %></h3>
          <p class="cf-meta"><%= s.subtitle || '' %></p>
          <p class="cf-desc"><%= s.text || '' %></p>
        </div>
      </a>
    <% }) %>

    <button class="cf-arrow next" type="button" aria-label="Next">&#10095;</button>
  </div>

  <div class="cf-progress"><span id="cfBar"></span></div>

  <div class="cf-dots" id="cfDots">
    <% slides.forEach((s, i) => { %><button type="button" aria-label="Go to slide <%= i + 1 %>"></button><% }) %>
  </div>
</section>

<style>
.cf { margin: 0 0 32px; }
.cf h2 { margin: 0 0 8px; }

.cf-stage {
  position: relative; height: 520px; overflow: hidden;
  touch-action: pan-y; user-select: none; -webkit-user-select: none;
  cursor: grab; outline: none;
}
.cf-stage.dragging { cursor: grabbing; }

.cf-card {
  position: absolute; left: 50%; top: 50%;
  width: 290px; height: 410px;
  border-radius: 18px; overflow: hidden;
  background: #1c1f28; color: #ffffff; text-decoration: none;
  box-shadow: 0 12px 30px rgba(0,0,0,.4);
  transition: transform .6s cubic-bezier(.22,.8,.25,1), opacity .6s ease, filter .6s ease;
  -webkit-user-drag: none;
}
.cf-img {
  width: 100%; height: 190px; object-fit: cover; display: block;
  -webkit-user-drag: none; pointer-events: none;
  transform: scale(1); transition: transform .6s ease;
}
.cf-body { padding: 14px 18px; }
.cf-body h3 { margin: 8px 0 2px; font-size: 1.2rem; color: inherit;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cf-meta { margin: 0; font-size: .92rem; opacity: .85; }
.cf-desc { display: none; }

.cf-card[data-pos="0"]  { transform: translate(-50%,-50%) scale(1.1); z-index: 3; }
.cf-card[data-pos="-1"] { transform: translate(calc(-50% - 250px),-50%) scale(.88); z-index: 2; filter: brightness(.75); }
.cf-card[data-pos="1"]  { transform: translate(calc(-50% + 250px),-50%) scale(.88); z-index: 2; filter: brightness(.75); }
.cf-card[data-pos="-2"] { transform: translate(calc(-50% - 440px),-50%) scale(.74); z-index: 1; filter: brightness(.55); }
.cf-card[data-pos="2"]  { transform: translate(calc(-50% + 440px),-50%) scale(.74); z-index: 1; filter: brightness(.55); }
.cf-card[data-pos="hidden"] { transform: translate(-50%,-50%) scale(.5); opacity: 0; pointer-events: none; }

/* Active card */
.cf-card[data-pos="0"] { background: #ffffff; color: #1f2430; }
.cf-card[data-pos="0"] .cf-img { animation: cfZoom 6s ease-out forwards; }
.cf-card[data-pos="0"] .cf-desc {
  display: block; margin: 10px 0 0; font-size: .95rem; line-height: 1.5;
  max-height: 150px; overflow-y: auto;
  animation: cfFade .7s ease both;
}
.cf-card[data-pos="0"] .cf-body { animation: cfRise .6s ease both; }

@keyframes cfZoom { from { transform: scale(1); } to { transform: scale(1.12); } }
@keyframes cfFade { from { opacity: 0; } to { opacity: 1; } }
@keyframes cfRise { from { opacity: .4; transform: translateY(8px); } to { opacity: 1; transform: none; } }

.cf-tag {
  display: inline-block; font-size: .74rem; font-weight: 600; text-transform: uppercase;
  padding: 2px 10px; border-radius: 99px; background: #dcfce7; color: #166534;
}

.cf-arrow {
  position: absolute; top: 50%; transform: translateY(-50%); z-index: 5;
  width: 42px; height: 42px; border: 0; border-radius: 50%;
  background: #ffffff; color: #1f2430; cursor: pointer; font-size: 1.05rem;
  transition: transform .2s ease;
}
.cf-arrow:hover { transform: translateY(-50%) scale(1.12); }
.cf-arrow.prev { left: 6px; }
.cf-arrow.next { right: 6px; }

/* Progress bar */
.cf-progress {
  width: 200px; max-width: 60%; height: 3px; margin: 6px auto 10px;
  background: rgba(255,255,255,.25); border-radius: 99px; overflow: hidden;
}
.cf-progress span { display: block; height: 100%; width: 0; background: #ffffff; }

.cf-dots { display: flex; justify-content: center; gap: 9px; margin-top: 4px; }
.cf-dots button { width: 10px; height: 10px; padding: 0; border: 0; border-radius: 50%;
  background: rgba(255,255,255,.45); cursor: pointer; transition: transform .2s ease, background .2s ease; }
.cf-dots button.on { background: #ffffff; transform: scale(1.3); }

@media (max-width: 800px) {
  .cf-stage { height: 480px; }
  .cf-card { width: 260px; height: 380px; }
  .cf-img { height: 170px; }
  .cf-card[data-pos="-1"] { transform: translate(calc(-50% - 190px),-50%) scale(.8); }
  .cf-card[data-pos="1"]  { transform: translate(calc(-50% + 190px),-50%) scale(.8); }
  .cf-card[data-pos="-2"], .cf-card[data-pos="2"] { opacity: 0; pointer-events: none; }
}

@media (prefers-reduced-motion: reduce) {
  .cf-card[data-pos="0"] .cf-img,
  .cf-card[data-pos="0"] .cf-desc,
  .cf-card[data-pos="0"] .cf-body { animation: none; }
  .cf-card { transition-duration: .01s; }
}
</style>

<script>
(function () {
  const stage = document.getElementById('cfStage');
  if (!stage) return;

  const cards = [...stage.querySelectorAll('.cf-card')];
  const dots = [...document.querySelectorAll('#cfDots button')];
  const bar = document.getElementById('cfBar');
  const n = cards.length;
  const half = Math.floor(n / 2);
  const DELAY = 4500;
  let cur = 0, timer = null;

  function render() {
    cards.forEach((c, i) => {
      const off = ((i - cur + n + half) % n) - half;
      c.dataset.pos = Math.abs(off) > 2 ? 'hidden' : off;
    });
    dots.forEach((d, i) => d.classList.toggle('on', i === cur));
  }

  function runBar() {
    bar.style.transition = 'none';
    bar.style.width = '0%';
    void bar.offsetWidth; // restart the transition
    bar.style.transition = 'width ' + DELAY + 'ms linear';
    bar.style.width = '100%';
  }

  function stopBar() {
    bar.style.transition = 'none';
    bar.style.width = '0%';
  }

  const go = d => { cur = (cur + d + n) % n; render(); };

  function start() {
    stop();
    if (n < 2) return;
    runBar();
    timer = setInterval(() => { go(1); runBar(); }, DELAY);
  }

  function stop() {
    clearInterval(timer);
    timer = null;
    stopBar();
  }

  if (n < 2) {
    stage.querySelectorAll('.cf-arrow').forEach(b => b.style.display = 'none');
    document.getElementById('cfDots').style.display = 'none';
  }

  // Arrows and dots
  stage.querySelector('.prev').addEventListener('click', () => { go(-1); start(); });
  stage.querySelector('.next').addEventListener('click', () => { go(1); start(); });
  dots.forEach((d, i) => d.addEventListener('click', () => { cur = i; render(); start(); }));

  // Keyboard
  stage.addEventListener('keydown', e => {
    if (e.key === 'ArrowLeft')  { go(-1); start(); }
    if (e.key === 'ArrowRight') { go(1);  start(); }
  });

  // Drag / swipe
  let startX = 0, dx = 0, down = false, moved = false;

  stage.addEventListener('pointerdown', e => {
    if (e.target.closest('.cf-arrow')) return;
    down = true; moved = false; startX = e.clientX; dx = 0;
  });

  window.addEventListener('pointermove', e => {
    if (!down) return;
    dx = e.clientX - startX;
    if (Math.abs(dx) > 8) {
      moved = true;
      stage.classList.add('dragging');
      stop(); // pause while dragging
    }
  });

  window.addEventListener('pointerup', () => {
    if (!down) return;
    down = false;
    stage.classList.remove('dragging');
    if (moved && Math.abs(dx) > 50) go(dx < 0 ? 1 : -1);
    start();
  });

  // Card clicks
  cards.forEach((c, i) => c.addEventListener('click', e => {
    if (moved) { e.preventDefault(); moved = false; return; }
    if (c.dataset.pos !== '0') { e.preventDefault(); cur = i; render(); start(); }
    else if (c.getAttribute('href') === '#') { e.preventDefault(); }
  }));

  // Pause when the tab is hidden
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) stop(); else start();
  });

  render();
  start();
})();
</script>
<% } %>