<%- include('../partials/header') %>
  <article class="detail">
<% if (item.image) { %>
  <img class="hero" src="/uploads/<%= item.image %>" alt="<%= item.title %>">
<% } %>
  <div>
    <span class="badge <%= item.type %>"><%= item.type %></span>
    <% if (item.status === 'returned') { %> <span class="badge returned">returned</span><% } %>
    <h1><%= item.title %></h1>
    <p class="muted"><%= item.category %> • <%= item.location %><% if (item.event_date) { %> • <%= item.event_date %><% } %></p>
    <p><%= item.description || 'No description provided.' %></p>
    <p class="muted">Posted by <%= item.poster %> on <%= item.created_at %></p>

    <% if (isOwner) { %>
      <div class="actions">
        <% if (item.status === 'open') { %>
          <form method="post" action="/items/<%= item.id %>/return"><button class="btn">Mark as returned</button></form>
        <% } %>
        <form method="post" action="/items/<%= item.id %>/delete" onsubmit="return confirm('Delete this report?')"><button class="btn danger">Delete</button></form>
      </div>
      <h2>Messages (<%= messages.length %>)</h2>
      <% if (!messages.length) { %><p class="muted">No messages yet.</p><% } %>
      <% messages.forEach(m => { %>
        <div class="msg"><strong><%= m.sender %></strong> <span class="muted">(<%= m.sender_email %>) • <%= m.created_at %></span><p><%= m.body %></p></div>
      <% }) %>
    <% } else if (item.status === 'open') { %>
      <h2>Contact <%= item.poster %></h2>
      <% if (user) { %>
        <form method="post" action="/items/<%= item.id %>/contact" class="form">
          <textarea name="body" rows="3" placeholder="Describe how you can identify it or where to meet..." required></textarea>
          <button class="btn">Send message</button>
        </form>
      <% } else { %>
        <p><a href="/login">Log in</a> to contact the poster.</p>
      <% } %>
    <% } %>
  </div>
</article>
<%- include('../partials/footer') %>